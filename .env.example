# required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
JWT_SECRET=<long-random-string>
GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# drive: app-level (Yoshik's Drive, folder "yoshik-play"), backend only.
# The refresh token is stored in Mongo `app_config` {_id:'drive'} via
# POST /api/drive/reconnect, so no env var is needed in production.
# For local dev you may set it directly instead:
# DRIVE_REFRESH_TOKEN=<google-oauth-refresh-token-with-drive.file-scope>
# To mint one: open the consent URL the /play settings "connect drive"
# button builds (access_type=offline, prompt=consent, drive.file scope),
# approve as Yoshik, and POST the returned code to /api/drive/reconnect.

# optional — spotify metadata (client credentials) for the upload
# name/artwork matcher. if missing, the iTunes Search API fallback is used.
# metadata only: never audio.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# optional
MONGO_DB=play
PORT=3000
CORS_ORIGIN=https://yoshik.xyz
